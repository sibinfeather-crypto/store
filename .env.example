# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY CONFIGURATION (India Payment Gateway)
# Test Mode Key ID and Secret from https://dashboard.razorpay.com/#/accesskeys
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# STORE & SUPPORT CONFIGURATION
VITE_WHATSAPP_NUMBER="919876543210"
VITE_STORE_NAME="FanKO Store"
VITE_SUPPORT_EMAIL="support@fankostore.in"

# ADMIN DEFAULT CREDENTIALS (Can also be configured during first-time in-app setup)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
